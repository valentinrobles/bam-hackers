{
  "name": "@mastra/server",
  "version": "1.67.0",
  "description": "",
  "type": "module",
  "files": [
    "dist",
    "./**/*.d.ts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./handlers": {
      "import": {
        "types": "./dist/server/handlers.d.ts",
        "default": "./dist/server/handlers.js"
      },
      "require": {
        "types": "./dist/server/handlers.d.ts",
        "default": "./dist/server/handlers.cjs"
      }
    },
    "./handlers/*": {
      "import": {
        "types": "./dist/server/handlers/*.d.ts",
        "default": "./dist/server/handlers/*.js"
      },
      "require": {
        "types": "./dist/server/handlers/*.d.ts",
        "default": "./dist/server/handlers/*.cjs"
      }
    },
    "./server-adapter": {
      "import": {
        "types": "./dist/server/server-adapter/index.d.ts",
        "default": "./dist/server/server-adapter/index.js"
      },
      "require": {
        "types": "./dist/server/server-adapter/index.d.ts",
        "default": "./dist/server/server-adapter/index.cjs"
      }
    },
    "./a2a/store": {
      "import": {
        "types": "./dist/server/a2a/store.d.ts",
        "default": "./dist/server/a2a/store.js"
      },
      "require": {
        "types": "./dist/server/a2a/store.d.ts",
        "default": "./dist/server/a2a/store.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/server/auth/index.d.ts",
        "default": "./dist/server/auth/index.js"
      },
      "require": {
        "types": "./dist/server/auth/index.d.ts",
        "default": "./dist/server/auth/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/server/schemas/index.d.ts",
        "default": "./dist/server/schemas/index.js"
      },
      "require": {
        "types": "./dist/server/schemas/index.d.ts",
        "default": "./dist/server/schemas/index.cjs"
      }
    },
    "./browser-stream": {
      "import": {
        "types": "./dist/server/browser-stream/index.d.ts",
        "default": "./dist/server/browser-stream/index.js"
      },
      "require": {
        "types": "./dist/server/browser-stream/index.d.ts",
        "default": "./dist/server/browser-stream/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mastra/core": ">=1.50.0-0 <2.0.0-0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/openai-v5": "npm:@ai-sdk/openai@2.0.115",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "canonicalize": "^1.0.8",
    "eslint": "^10.7.0",
    "oxfmt": "0.59.0",
    "superjson": "^2.2.6",
    "tsdown": "0.22.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@^6.0.3",
    "vitest": "4.1.10",
    "zod": "^4.4.3",
    "zod-to-ts": "^2.1.0",
    "@internal/lint": "0.0.133",
    "@internal/storage-test-utils": "0.0.129",
    "@internal/core": "0.1.2",
    "@internal/test-utils": "0.0.69",
    "@internal/types-builder": "0.0.108",
    "@internal/voice": "0.0.31",
    "@mastra/core": "1.67.0",
    "@mastra/agent-builder": "1.1.19",
    "@mastra/schema-compat": "1.3.10"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "hono": "^4.12.8"
  },
  "scripts": {
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "build:patch-commonjs": "node ../../scripts/commonjs-tsc-fixer.js",
    "build:watch": "pnpm build:lib --watch",
    "pull:openapispec": "node src/server/openapi.script.js",
    "generate:permissions": "tsx scripts/generate-permissions.ts",
    "generate:api-cli-route-metadata": "tsx scripts/generate-api-cli-route-metadata.ts",
    "generate:route-types": "tsx scripts/generate-route-types.ts",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  }
}