{
  "name": "mastra",
  "version": "1.30.0",
  "license": "Apache-2.0",
  "description": "cli for mastra",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mastra": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./internal/auth": "./dist/internal/auth.js",
    "./package.json": "./package.json",
    "./dist/*": [
      "./dist/*",
      "./dist/*.js"
    ]
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mastra",
    "cli",
    "ai",
    "llm",
    "llms",
    "agent",
    "agents",
    "dev",
    "development",
    "deploy",
    "deployment",
    "build",
    "workflow",
    "typescript",
    "command-line",
    "devtools"
  ],
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@clack/prompts": "^1.7.0",
    "@expo/devcert": "^1.2.1",
    "archiver": "^8.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "get-port": "^7.1.0",
    "local-pkg": "^1.1.2",
    "openapi-fetch": "^0.17.0",
    "picocolors": "^1.1.1",
    "posthog-node": "^5.46.1",
    "semver": "^7.7.4",
    "serve-handler": "^6.1.7",
    "strip-json-comments": "^5.0.3",
    "tinyglobby": "^0.2.17",
    "yocto-spinner": "^1.1.0",
    "@mastra/loggers": "^1.3.2",
    "@mastra/deployer": "^1.67.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@types/archiver": "^8.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "22.20.1",
    "@types/semver": "^7.7.1",
    "@types/serve-handler": "^6.1.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^10.7.0",
    "memfs": "^4.56.11",
    "rollup": "^4.62.2",
    "tsdown": "0.22.9",
    "tsx": "^4.23.1",
    "type-fest": "^5.4.4",
    "typescript": "^7.0.2",
    "vitest": "4.1.10",
    "zod": "^4.4.3",
    "@internal/factory-ui": "0.0.0",
    "@internal/playground": "1.30.0",
    "@internal/types-builder": "0.0.108",
    "@mastra/core": "1.67.0",
    "@internal/lint": "0.0.133"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.50.0-0 <2.0.0-0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:api-manifest": "pnpm --filter @mastra/server generate:api-cli-route-metadata && pnpm --filter @mastra/factory generate:api-cli-route-metadata",
    "generate:mcp-api-operations": "tsx scripts/generate-mcp-api-operations.ts",
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist && rm -rf node_modules",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  }
}